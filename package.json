{
	"name": "chrome-extension",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "wxt",
		"dev:firefox": "wxt -b firefox",
		"check": "vue-tsc --noEmit",
		"build": "npm run check && wxt build",
		"build:firefox": "npm run check && wxt build -b firefox",
		"zip": "wxt zip",
		"zip:firefox": "wxt zip -b firefox",
		"postinstall": "wxt prepare",
		"format": "npx prettier . --write"
	},
	"dependencies": {
		"pinia": "^3.0.4",
		"vue": "^3.5.38"
	},
	"devDependencies": {
		"@tsconfig/node24": "^24.0.4",
		"@types/node": "^24.13.2",
		"@vue/tsconfig": "^0.9.1",
		"@wxt-dev/module-vue": "^1.0.3",
		"npm-run-all2": "^9.0.2",
		"prettier": "^3.9.5",
		"typescript": "~6.0.0",
		"vue-tsc": "^3.3.5",
		"wrangler": "^4.119.0",
		"wxt": "^0.21.3"
	},
	"engines": {
		"node": "^22.18.0 || >=24.12.0"
	}
}
